{
  "name": "surveyql",
  "version": "0.1.0",
  "description": "A tiny domain-specific language for querying and visualizing SurveyJS data.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./surveycore": {
      "types": "./dist/surveycore/index.d.ts",
      "import": "./dist/surveycore/index.js",
      "require": "./dist/surveycore/index.cjs"
    },
    "./visualization": {
      "types": "./dist/visualization/index.d.ts",
      "import": "./dist/visualization/index.js",
      "require": "./dist/visualization/index.cjs"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "bin": {
    "surveyql": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite",
    "build:web": "vite build",
    "cli": "node dist/cli/main.js",
    "dev:cli": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "apexcharts": "^7.4.0",
    "survey-analytics": "^3.1.0",
    "survey-core": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
